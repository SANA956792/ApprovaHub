# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PostgreSQL Database Configuration (Cloud SQL / Managed PostgreSQL Object Parameters)
SQL_HOST="localhost"
SQL_DB_NAME="approval_db"
SQL_USER="app_user"
SQL_PASSWORD="YOUR_SQL_PASSWORD"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD"

# Authentication & Security Secrets
JWT_SECRET="YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARS"

# Designated Super Admin Initial Passwords
SALMAN_ADMIN_PASSWORD="YOUR_SALMAN_ADMIN_PASSWORD"
MUNAVVAR_ADMIN_PASSWORD="YOUR_MUNAVVAR_ADMIN_PASSWORD"
LEARNING_APP_ADMIN_PASSWORD="YOUR_LEARNING_APP_ADMIN_PASSWORD"
SALWA_ADMIN_PASSWORD="YOUR_SALWA_ADMIN_PASSWORD"
SALWA_ADMIN_MOBILE="9895000004"

# Web Push (VAPID) Notification Keys
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:admin@ibat.in"

# Supabase Storage (Primary Attachment Storage Provider)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_BUCKET_NAME="approval-attachments"
